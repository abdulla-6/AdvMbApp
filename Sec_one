import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: HomePage(),
    );
  }
}

class HomePage extends StatelessWidget {
  const HomePage({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text("Main Page")),
      body: GestureDetector(
        onTap: () {
          Navigator.push(
            context,
            MaterialPageRoute(builder: (context) => const DetailClass()),
          );
        },
        // Aligns the Hero widget to the top left of the screen
        child: const Align(
          alignment: Alignment.topLeft,
          child: Padding(
            padding: EdgeInsets.all(16.0),
            child: Hero(
              tag: 'hero-logo',
              child: FlutterLogo(size: 80),
            ),
          ),
        ),
      ),
    );
  }
}

class DetailClass extends StatelessWidget {
  const DetailClass({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: GestureDetector(
        onTap: () => Navigator.pop(context),
        // Centers the Hero widget in the middle of the screen
        child: const Center(
          child: Hero(
            tag: 'hero-logo',
            child: FlutterLogo(size: 200),
          ),
        ),
      ),
    );
  }
}
