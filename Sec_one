import 'package:flutter/material.dart';

void main() {
  runApp(const MaterialApp(
    debugShowCheckedModeBanner: false,
    home: AnimatedRotationApp(),
  ));
}

class AnimatedRotationApp extends StatelessWidget {
  const AnimatedRotationApp({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text("Demo 3"),
        centerTitle: true,
        backgroundColor: Colors.blue,
      ),
      body: const ImageAnimatee(),
    );
  }
}

class ImageAnimatee extends StatefulWidget {
  const ImageAnimatee({super.key});

  @override
  State<ImageAnimatee> createState() => _ImageAnimateeState();
}

class _ImageAnimateeState extends State<ImageAnimatee> {
  double _turns = 0.0;

  @override
  Widget build(BuildContext context) {
    return Column(
      mainAxisAlignment: MainAxisAlignment.center,
      children: [
        AnimatedRotation(
          turns: _turns,
          duration: const Duration(milliseconds: 300),
          child: const FlutterLogo(size: 200),
        ),
        const SizedBox(height: 50),
        Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            ElevatedButton(
              onPressed: () {
                setState(() => _turns -= 0.25); // Rotate Left
              },
              child: const Text("Rotate Left"),
            ),
            const SizedBox(width: 20),
            ElevatedButton(
              onPressed: () {
                setState(() => _turns += 0.25); // Rotate Right
              },
              child: const Text("Rotate Right"),
            ),
          ],
        ),
      ],
    );
  }
}
