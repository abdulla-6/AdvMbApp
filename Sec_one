import 'package:flutter/material.dart';

void main() {
  runApp(const MaterialApp(
    debugShowCheckedModeBanner: false,
    home: AnimatedCrossFadeApp(),
  ));
}

class AnimatedCrossFadeApp extends StatelessWidget {
  const AnimatedCrossFadeApp({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text("Animation"),
        centerTitle: true,
        backgroundColor: Colors.blue,
      ),
      body: const Center(
        child: ImageAnimatee(),
      ),
    );
  }
}

class ImageAnimatee extends StatefulWidget {
  const ImageAnimatee({super.key});

  @override
  State<ImageAnimatee> createState() => _ImageAnimateeState();
}

class _ImageAnimateeState extends State<ImageAnimatee> {
  bool _selected = false;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Column(
        children: [
          Container(
            width: double.infinity,
            height: 500,
            color: Colors.blue.shade100,
            child: Center(
              child: AnimatedRotation(
                // Rotates 1 full turn (360 degrees) when selected, 0 when not
                turns: _selected ? 1 : 0,
                duration: const Duration(seconds: 1),
                child: const FlutterLogo(
                  size: 200,
                ),
              ),
            ),
          ),
          const SizedBox(height: 20),
          ElevatedButton(
            onPressed: () {
              setState(() {
                _selected = !_selected;
              });
            },
            child: const Text("Rotate"),
          ),
        ],
      ),
    );
  }
}
