import 'package:flutter/material.dart';

void main() {
  runApp(const MaterialApp(home: HomePage()));
}

class HomePage extends StatefulWidget {
  const HomePage({super.key});

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  // We use a counter for 90-degree turns. 
  // 1.0 represents a full 360-degree rotation.
  double _turns = 0.0;

  void _rotateLeft() {
    setState(() {
      _turns -= 0.25; // Subtract 90 degrees
    });
  }

  void _rotateRight() {
    setState(() {
      _turns += 0.25; // Add 90 degrees
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text("Demo 3"),
        centerTitle: true,
        backgroundColor: Colors.blue,
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            // AnimatedRotation handles the smooth transition automatically
            AnimatedRotation(
              turns: _turns,
              duration: const Duration(milliseconds: 300),
              child: const FlutterLogo(size: 200),
            ),
            const SizedBox(height: 30),
            Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                ElevatedButton(
                  onPressed: _rotateLeft,
                  child: const Text('Rotate Left'),
                ),
                const SizedBox(width: 30),
                ElevatedButton(
                  onPressed: _rotateRight,
                  child: const Text('Rotate Right'),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}
